{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://asd-engineering.github.io/asd-caddy-api-client/schemas/caddy-handler-rewrite.json",
  "title": "Caddy Handler Rewrite",
  "description": "Caddy rewrite handler configuration",
  "$ref": "#/definitions/caddy-handler-rewrite",
  "definitions": {
    "caddy-handler-rewrite": {
      "type": "object",
      "properties": {
        "handler": {
          "type": "string",
          "const": "rewrite"
        },
        "uri": {
          "type": "string"
        },
        "strip_path_prefix": {
          "type": "string"
        },
        "strip_path_suffix": {
          "type": "string"
        },
        "uri_substring": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "find": {
                "type": "string"
              },
              "replace": {
                "type": "string"
              },
              "limit": {
                "type": "integer"
              },
              "@id": {
                "type": "string"
              }
            },
            "required": ["find", "replace"],
            "additionalProperties": false
          }
        },
        "query": {
          "type": "object",
          "properties": {
            "delete": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "set": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string"
                  },
                  "val": {
                    "type": "string"
                  },
                  "@id": {
                    "type": "string"
                  }
                },
                "required": ["key", "val"],
                "additionalProperties": false
              }
            },
            "add": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/caddy-handler-rewrite/properties/query/properties/set/items"
              }
            },
            "replace": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string"
                  },
                  "search": {
                    "type": "string"
                  },
                  "search_regexp": {
                    "type": "string"
                  },
                  "replace": {
                    "type": "string"
                  },
                  "@id": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            },
            "rename": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/caddy-handler-rewrite/properties/query/properties/set/items"
              }
            },
            "@id": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "@id": {
          "type": "string"
        }
      },
      "required": ["handler"],
      "additionalProperties": false
    }
  }
}
